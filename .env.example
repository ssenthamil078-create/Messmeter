# Copy this file to .env and fill in your own values. Never commit .env.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql+psycopg://messmeter:messmeter@localhost:5432/messmeter
CORS_ORIGINS=http://localhost:5173

# Used by docker-compose.yml for the local PostgreSQL container
POSTGRES_USER=messmeter
POSTGRES_PASSWORD=messmeter
POSTGRES_DB=messmeter
